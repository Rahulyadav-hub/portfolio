# Backend environment variables - set in your host dashboard; never commit real values
PORT=8080
DB_URL=jdbc:mysql://HOST:3306/portfolio_db?useSSL=true&serverTimezone=UTC
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
CORS_ALLOWED_ORIGINS=https://your-portfolio.vercel.app
CONTACT_MAX_PER_HOUR=5
LOG_LEVEL=INFO
